{
  "models": [
    "mock-model",
    "mock-reviewer"
  ],
  "rules": [
    {
      "when": {
        "last_user_contains": "\"kind\":\"artist_identity\"",
        "tool_available": "shelve_pending_item"
      },
      "reply": {
        "tool_calls": [
          {
            "name": "shelve_pending_item",
            "arguments": {
              "item_id": "$current_item",
              "reason": "本组固定样本未提供独立的艺人联网资料。"
            }
          }
        ]
      }
    },
    {
      "when": {
        "last_user_contains": "legacy-many/01.mp3",
        "tool_available": "submit_local_cleanup"
      },
      "reply": {
        "tool_calls": [
          {
            "name": "submit_local_cleanup",
            "arguments": {
              "item_id": "$current_item",
              "decision": "apply",
              "encodings": [
                {
                  "release_id": "$release:legacy-many/01.mp3",
                  "encoding": "GBK"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "when": {
        "last_user_contains": "堤灯社 - 微雨塘",
        "tool_available": "submit_local_cleanup"
      },
      "reply": {
        "tool_calls": [
          {
            "name": "submit_local_cleanup",
            "arguments": {
              "item_id": "$current_item",
              "decision": "apply",
              "texts": [
                {
                  "target_id": "$release:embedded-artist/01.flac",
                  "field": "title",
                  "value": "微雨塘"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "when": {
        "item_kind": "release_match",
        "last_user_contains": "枝航圃"
      },
      "reply": {
        "text": "{\"decision\":\"judge\",\"groups\":[{\"name\":{\"release\":\"枝航谱\"}}]}"
      }
    },
    {
      "when": {
        "item_kind": "release_match",
        "last_user_contains": "Hoshi no Mado"
      },
      "reply": {
        "text": "{\"decision\":\"judge\",\"groups\":[{\"name\":{\"release\":\"星の窓\"}}]}"
      }
    },
    {
      "when": {
        "item_kind": "verify_name",
        "last_user_contains": "枝航圃"
      },
      "reply": {
        "text": "{\"verdict\":\"typo\",\"reason\":\"扫描标题错字\"}"
      }
    },
    {
      "when": {
        "item_kind": "verify_name",
        "last_user_contains": "沉心"
      },
      "reply": {
        "text": "{\"verdict\":\"typo\",\"reason\":\"扫描曲名错字\"}"
      }
    }
  ]
}
