# 复制为 .env.prod 并 chmod 600；不要提交真实密码，不要 source 此文件。
# 必填：数据库密码，仅用字母和数字；用 openssl rand -hex 24 生成，首次部署后改此值不会修改库内密码。
ROOMUSIC_DB_PASSWORD=ReplaceWithRandomHexBeforeDeploy
# 可选：不填时用浏览器打开的网址访问即可，反代须保留 Host（含端口）与 Origin。
# 只想放行固定网址，或反代改写了 Host 时再填；多个完整来源用逗号分隔。
# ROOMUSIC_ALLOWED_ORIGINS=http://192.168.50.206:8090,https://music.example.com
# 必填：IPv4 局域网端口，8080 留给开发。
ROOMUSIC_HTTP_PORT=8090
# 必填：已存在的宿主机音乐绝对路径，只读挂载为 /music；目录值写字面量，不使用变量替换。
ROOMUSIC_MUSIC_DIR=/home/qlqq/workspace/ROOMusic/music
# 必填：已创建且 uid 1000 可写的宿主机备份绝对路径，放在仓库外。
ROOMUSIC_BACKUP_DIR=/home/qlqq/roomusic-backups
# 必填：生产固定子网；演练单独使用 10.203.51.0/24，不使用 Docker 自动地址池。
ROOMUSIC_SUBNET=10.203.50.0/24
# 可选：备份时区，默认 Asia/Shanghai。
ROOMUSIC_TIMEZONE=Asia/Shanghai
# 可选：每天几点后备份（0–23），默认 3。
ROOMUSIC_BACKUP_HOUR=3
# 可选：保留天数（正整数），默认 14，仅成功备份后清理。
ROOMUSIC_BACKUP_KEEP_DAYS=14
# 可选：ALAC 转换缓存上限（MiB，至少 256），默认 10240。
ROOMUSIC_MEDIA_CACHE_MAX_MIB=10240
