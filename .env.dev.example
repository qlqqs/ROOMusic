# 本地开发用，复制为 .env.dev 后执行 make dev；部署生产请用 .env.prod.example。

# 必填
# 本地数据库密码，换成自己的密码，并与 ROOMUSIC_DATABASE_URL 里的密码保持一致。
PG_PASSWORD=replace-with-a-local-password
# 后端连接数据库的地址，本机通常用下面的地址，密码须与 PG_PASSWORD 一致。
ROOMUSIC_DATABASE_URL=postgres://roomusic:replace-with-a-local-password@localhost:5432/roomusic?sslmode=disable
# 本机音乐目录的绝对路径，改成实际目录；多个目录用英文逗号分隔。
ROOMUSIC_ALLOWED_LIBRARY_ROOTS=/music

# 可选：本机通常保留以下设置
# 数据库名称，通常填 roomusic；修改时同步 ROOMUSIC_DATABASE_URL。
PG_DATABASE=roomusic
# 数据库用户名，通常填 roomusic；修改时同步 ROOMUSIC_DATABASE_URL。
PG_USER=roomusic
# 数据库的本机端口，通常填 5432；修改时同步 ROOMUSIC_DATABASE_URL。
PG_PORT=5432
# 运行环境，本地开发填 dev。
ROOMUSIC_ENV=dev
# 后端监听地址，本机通常填 :8080。
ROOMUSIC_HTTP_ADDR=:8080
# 登录 Cookie 是否只走 HTTPS，本机 HTTP 访问填 false。
ROOMUSIC_SECURE_COOKIES=false
# 对外访问的网址，本机通常保留下面的地址。
# 通过公网反代访问 Vite 时，改成外部 HTTPS 网址，并将 ROOMUSIC_SECURE_COOKIES 设为 true；开发脚本会允许该域名访问。
ROOMUSIC_PUBLIC_URL=http://localhost:8080
# 允许访问的完整网址，通常留空；多个用英文逗号分隔，填写时包含 ROOMUSIC_PUBLIC_URL 并删除 ROOMUSIC_SECURE_COOKIES。
# ROOMUSIC_ALLOWED_ORIGINS=
# 缓存和备份目录，默认 ./data；make dev 下是 backend/data/，不要放进音乐目录。
ROOMUSIC_DATA_DIR=./data
# ALAC 播放所需的 ffmpeg 绝对路径，留空自动查找；可运行 ./scripts/ffmpeg-pinned.sh 获取路径。
ROOMUSIC_FFMPEG_PATH=
# 转换音频的缓存上限，通常填 10240 MiB（最小 256），文件放在 ROOMUSIC_DATA_DIR/media-cache。
ROOMUSIC_MEDIA_CACHE_MAX_MIB=10240

# 可选容器：应用目前不用 Redis 和 Meilisearch，但 Compose 仍要求填写 MEILI_MASTER_KEY
# Redis 的本机端口，通常填 6379。
REDIS_PORT=6379
# Meilisearch 的本机端口，通常填 7700。
MEILI_PORT=7700
# Meilisearch 的访问密钥，必须填写，换成自己的本地密钥。
MEILI_MASTER_KEY=replace-with-a-local-master-key
