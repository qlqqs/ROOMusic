# 本文件只提供本地开发示例，不要填写或提交生产密钥。
PG_DATABASE=roomusic
PG_USER=roomusic
PG_PASSWORD=replace-with-a-local-password
PG_PORT=5432

REDIS_PORT=6379

MEILI_MASTER_KEY=replace-with-a-local-master-key
MEILI_PORT=7700

# 后端落地后可直接复用以下连接变量。
ROOMUSIC_ENV=dev
ROOMUSIC_HTTP_ADDR=:8080
ROOMUSIC_ALLOWED_LIBRARY_ROOTS=/music
# 以下 SECURE_COOKIES / PUBLIC_URL 仅用于开发旧模式；清单模式不能设置 SECURE_COOKIES。
ROOMUSIC_SECURE_COOKIES=false
# 通过公网反代访问 Vite 开发服务时，改为反代后的外部地址（如 https://music.example.com），
# 同时把 ROOMUSIC_SECURE_COOKIES 设为 true；dev.sh 会用该地址的主机名作为 Vite allowedHosts。
ROOMUSIC_PUBLIC_URL=http://localhost:8080
# 生产可选，见 deploy/production/example.env；逗号分隔完整来源，清单模式下 PUBLIC_URL 若设置必须在清单内。
# ROOMUSIC_ALLOWED_ORIGINS=
ROOMUSIC_DATABASE_URL=postgres://roomusic:replace-with-a-local-password@localhost:5432/roomusic?sslmode=disable
# ALAC 播放需要 ffmpeg（项目不分发）：./scripts/ffmpeg-pinned.sh 取出固定版本并打印路径，填在这里（绝对路径）；
# 留空则在 PATH 中查找，找不到时应用照常启动，ALAC 仍标注“不能直接播放”。
ROOMUSIC_FFMPEG_PATH=
# 派生缓存上限（MiB，默认 10240，最小 256）；缓存在 <ROOMUSIC_DATA_DIR>/media-cache，必须在音乐目录之外。
ROOMUSIC_MEDIA_CACHE_MAX_MIB=10240
ROOMUSIC_REDIS_URL=redis://localhost:6379
ROOMUSIC_MEILISEARCH_URL=http://localhost:7700
ROOMUSIC_MEILISEARCH_MASTER_KEY=replace-with-a-local-master-key
