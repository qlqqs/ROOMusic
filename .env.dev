# 本地开发配置，不要填入生产密钥。
PG_DATABASE=roomusic
PG_USER=roomusic
PG_PASSWORD=roomusic-dev-local
PG_PORT=5432
REDIS_PORT=6379
MEILI_PORT=7700
MEILI_MASTER_KEY=replace-with-a-local-master-key
ROOMUSIC_ENV=dev
ROOMUSIC_HTTP_ADDR=:8080
ROOMUSIC_ALLOWED_LIBRARY_ROOTS=/root/workspace/ROOMusic/music
ROOMUSIC_SECURE_COOKIES=true
ROOMUSIC_PUBLIC_URL=https://music.qlqqs.com:8888
ROOMUSIC_DATABASE_URL=postgres://roomusic:roomusic-dev-local@localhost:5432/roomusic?sslmode=disable
ROOMUSIC_REDIS_URL=redis://localhost:6379
ROOMUSIC_MEILISEARCH_URL=http://localhost:7700
ROOMUSIC_MEILISEARCH_MASTER_KEY=replace-with-a-local-master-key
